# ═══════════════════════════════════════════════════════════════
# Ensoul Server Configuration
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
PORT=8990
ENV=development                # development | production
# LOG_LEVEL=                   # debug | info | warn | error (auto-set by ENV if omitted)

# ── Database (PostgreSQL) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=ensoul
DB_PASSWORD=ensoul
DB_NAME=ensoul
DB_SSLMODE=disable             # disable | require (production 建议 require)

# ── BNB Smart Chain ────────────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org/
# 防夹子（MEV 保护）私有 RPC — swap 交易走此节点发送，不进公共 mempool
# 推荐 48 Club（免费）: https://rpc-bsc.48.club
# 留空则 swap 交易走公共 RPC（有被三明治攻击风险）
SWAP_RPC_URL=https://rpc-bsc.48.club
IDENTITY_REGISTRY_ADDR=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
REPUTATION_REGISTRY_ADDR=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# Platform wallet private key — 用于链上 mint Soul NFT
# ⚠️ 不要泄露！生产环境建议用 KMS 或 vault
PLATFORM_PRIVATE_KEY=

# AES-256 密钥 — 用于加密 Claw 的 private key（64 hex chars = 32 bytes）
# 生成命令: openssl rand -hex 32
CLAW_PK_SECRET=

# 管理员 API Key — 用于 /api/admin/* 端点（候选管理、税收钱包操作等）
# 生成命令: openssl rand -hex 32
ADMIN_API_KEY=

# 管理员登录账号 — 首次启动时自动创建管理员用户（种子账号）
# 创建后可删除这两个环境变量，后续通过管理界面管理
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                # 至少 8 位，生产环境请使用强密码

# ── LLM API ────────────────────────────────────────────────────
LLM_PROVIDER=openai            # openai | claude
LLM_API_KEY=                   # OpenAI / Claude / DeepSeek 的 API Key
LLM_MODEL=gpt-4o               # 模型名称，如 gpt-4o, deepseek-chat, claude-sonnet-4-20250514
# 自定义 Base URL（兼容 OpenAI 格式的第三方 API）
# 例: https://api.deepseek.com/v1  或  https://openrouter.ai/api/v1
LLM_BASE_URL=

# ── Twitter Data Sources ───────────────────────────────────────
# 优先级: SocialData API → Twitter v2 API → Mock 兜底

# [推荐] SocialData.tools API — $0.0002/请求，约 $0.012/soul
# 申请地址: https://socialdata.tools
SOCIALDATA_API_KEY=
# SOCIALDATA_BASE_URL=         # 默认 https://api.socialdata.tools（通常无需修改）

# [可选] Twitter v2 API Bearer Token — 作为 fallback
# 申请地址: https://developer.twitter.com
TWITTER_BEARER_TOKEN=

# ═══════════════════════════════════════════════════════════════
# 经济系统配置（Ensoul-Next 经济系统）
# ═══════════════════════════════════════════════════════════════

# ── 合约地址 ────────────────────────────────────────────────────
# $Ensoul ERC-20 代币合约
ENSOUL_TOKEN_ADDR=0xf671f96f7763e88ea92ff7db79d57c0ee3c7ffff
# $Ensoul/BNB LP 地址（PancakeSwap V2）
ENSOUL_LP_ADDR=0xe23045b5bbf338cda9e9fbc07637a1523ae318a0
# EnsoulMinterV2 合约（部署后填入）
ENSOUL_MINTER_V2_ADDR=
# PancakeSwap V2 Router
PANCAKE_ROUTER_ADDR=0x10ED43C718714eb63d5aA57B78B54704E256024E
# BSC USDT 合约
USDT_ADDR=0x55d398326f99059fF775485246999027B3197955

# ── 钱包私钥（6 钱包方案）──────────────────────────────────────
# ⚠️ 所有私钥不要泄露！生产环境建议用 KMS 或 vault
#
# 1. Platform Wallet — 签名用（mint permit、Soul 注册、URI 更新）
#    已有配置: PLATFORM_PRIVATE_KEY（上方）
#
# 2. Treasury Wallet — 冷钱包，接收铸造费 BNB + 订阅费 USDT
#    仅需地址，私钥不在服务器上（冷钱包/多签管理）
TREASURY_ADDR=
#
# 3. Tax Wallet — 接收 $Ensoul 3% 交易税，用税收 Mint 公共 Soul
#    需要私钥（服务器自动调用 EnsoulMinterV2.mint）
TAX_WALLET_PRIVATE_KEY=
#
# 4. Buyback Wallet — 执行 PancakeSwap 回购（BNB/USDT → $Ensoul）
BUYBACK_PRIVATE_KEY=
#
# 5. Mining Pool Wallet — 持有挖矿奖励 $Ensoul，发放给 Claw
MINING_POOL_PRIVATE_KEY=
#
# 6. Revenue Pool Wallet — 持有持有者分润 $Ensoul，供持有者 claim
REVENUE_POOL_PRIVATE_KEY=

# ═══════════════════════════════════════════════════════════════
# 邮件 SMTP 配置（邮箱登录验证码）
# ═══════════════════════════════════════════════════════════════
SMTP_HOST=smtp.protonmail.ch   # Proton Mail SMTP 服务器
SMTP_PORT=587                  # STARTTLS 端口
SMTP_USER=                     # Proton Mail 邮箱（如 noreply@ensoul.ac）
SMTP_PASSWORD=                 # Proton Mail SMTP 专用密码（Bridge 或 App Password）
SMTP_FROM=Ensoul <noreply@ensoul.ac>
# 开发模式下留空 SMTP_USER 即可，验证码会打印到终端日志

# ═══════════════════════════════════════════════════════════════
# LemonSqueezy 订阅支付（Pro $49/月）
# ═══════════════════════════════════════════════════════════════
LEMONSQUEEZY_API_KEY=          # LemonSqueezy 后台 → Settings → API 获取
LEMONSQUEEZY_STORE_ID=         # 店铺 ID
LEMONSQUEEZY_VARIANT_ID=       # Pro 计划的 Variant ID
LEMONSQUEEZY_WEBHOOK_SECRET=   # Webhook 签名密钥（Settings → Webhooks）

# ═══════════════════════════════════════════════════════════════
# Crypto 付款（BSC USDT / BNB，作为 LemonSqueezy 的并行兜底通道）
# ═══════════════════════════════════════════════════════════════
# 收款钱包地址（仅地址，不要私钥；建议独立于平台热钱包）
PAYMENT_RECIPIENT_ADDR=
# 最小区块确认数（BSC 出块 ~3s；2 = ~6s）
PAYMENT_MIN_CONFIRM=2
# Pro 价格（USDT，1:1 等同 USD）
PRO_PRICE_USDT=49
# Pro 一次性付款时长（天）
PRO_DURATION_DAYS=30
# BNB 报价缓冲（基点，150 = 1.5%）—— 前端报价多算一点防价格漂移
PRO_BNB_QUOTE_BUFFER_BPS=150
# 后端校验 BNB 实付折算 USDT 的容忍下浮（基点，200 = 2%）
PRO_BNB_VERIFY_TOLERANCE_BPS=200

# ═══════════════════════════════════════════════════════════════
# V4 — Galaxy 知识图谱协议（合约地址 / Phase 2+3）
# ═══════════════════════════════════════════════════════════════
# 留空 = 该合约尚未部署 → 对应上链路径会跳过（仅 DB 落库），本地开发不会崩。
#
# Phase 2 — Epoch 锚点 + Galaxy NFT
# 部署 contracts/EnsoulEpochRegistry.sol 后填入
EPOCH_REGISTRY_ADDR=
# 部署 contracts/EnsoulGalaxyNFT.sol 后填入
GALAXY_NFT_ADDR=
#
# Phase 3 — 公平发射
# 部署 contracts/EnsoulFairLaunch.sol 后填入
# 该地址同时需要前端 NEXT_PUBLIC_FAIR_LAUNCH_ADDR（见 web/.env.local.example）
FAIR_LAUNCH_ADDR=
#
# 注：CommunityToken (contracts/EnsoulCommunityToken.sol) 是 per-Galaxy
# 部署，由 FairLaunch 工厂在 finalize 阶段创建，地址保存在 launches 表，
# 故不在这里配置全局地址。

